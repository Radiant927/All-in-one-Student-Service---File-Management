# 应用配置
APP_NAME=跨校区文件交接管理系统
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库连接地址，SQLite 用相对路径即可
DATABASE_URL=sqlite:///./campus_file.db

# JWT 鉴权密钥，生产环境务必改成随机字符串
SECRET_KEY=change-me-to-a-random-string-please-change-in-production
ALGORITHM=HS256
# Token 有效期，单位分钟，1440 = 24小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件上传
UPLOAD_DIR=./uploads
# 最大上传大小 50MB
MAX_UPLOAD_SIZE=52428800

# 企业微信群机器人 Webhook 地址
WECHAT_WEBHOOK_URL=

# 逾期提醒阈值：到达后多少小时未确认算逾期
OVERDUE_HOURS=3
